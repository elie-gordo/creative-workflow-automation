                    "option": "direct"
                  },
                  {
                    "option": "expert"
                  },
                  {
                    "option": "ludique"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Appel à l'action (optionnel)",
              "placeholder": "Disponible en boutique"
